# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (MySQL + Drizzle)
DATABASE_URL=mysql://paypilot:paypilot_dev_pw@localhost:3306/paypilot

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# Internal endpoints (e.g. POST /internal/reminders/process)
INTERNAL_API_KEY=change-me-in-production

# Stripe (test mode secret key; get yours from the Stripe Dashboard)
STRIPE_SECRET_KEY=sk_test_change-me
# From `stripe listen --forward-to localhost:3000/webhooks/stripe` for local dev,
# or the Dashboard's webhook endpoint config in production. POST /webhooks/stripe
# rejects all events until this is set.
# STRIPE_WEBHOOK_SECRET=

# Teekrr (WhatsApp reminders). Auth is `Authorization: Bearer <key>`, key
# needs the send_whatsapp permission. Get real values from the Teekrr dashboard.
TEEKRR_BASE_URL=https://staging-api.teekrr.com
TEEKRR_API_KEY=teekrr_change-me
# Name of a pre-approved WhatsApp template (created + approved via the Teekrr
# dashboard — there's no API to list or create templates with an API key).
# POST /bills/:id/reminder 503s until this is set.
# TEEKRR_WHATSAPP_TEMPLATE_NAME=

# No settlement gateway is wired in — SettlementService always mocks a
# successful push to the biller (see src/payments/settlement.service.ts).
# Every attempt is still logged to biller_push_attempts, marked as mocked.
